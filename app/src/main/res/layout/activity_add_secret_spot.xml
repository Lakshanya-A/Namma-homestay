<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ Add a Secret Spot"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginBottom="16dp"/>

        <!-- Image Preview -->
        <ImageView
            android:id="@+id/ivSpotPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="#E0E0E0"
            android:layout_marginBottom="10dp"
            android:src="@android:drawable/ic_menu_gallery"/>

        <Button
            android:id="@+id/btnUploadSpotImage"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📸 Add Spot Photo"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:layout_marginBottom="20dp"/>

        <!-- Spot Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:boxStrokeColor="#5D4037"
            app:hintTextColor="#5D4037">
            <EditText
                android:id="@+id/etSpotName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Spot Name (e.g. Hidden Waterfall)"
                android:textColor="#3E2723"
                android:background="@android:drawable/edit_text"
                android:padding="12dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Spot Type -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:boxStrokeColor="#5D4037"
            app:hintTextColor="#5D4037">
            <EditText
                android:id="@+id/etSpotType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Type (Waterfall, Viewpoint, Trek, etc.)"
                android:textColor="#3E2723"
                android:background="@android:drawable/edit_text"
                android:padding="12dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnGenerateSpotAI"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🤖 Generate Mysterious Description"
            android:backgroundTint="#7E57C2"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:layout_marginBottom="12dp"/>

        <!-- Description -->
        <EditText
            android:id="@+id/etSpotDescription"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="A mysterious and inviting description..."
            android:gravity="top"
            android:padding="12dp"
            android:textColor="#3E2723"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSaveSpot"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="✅ Save Secret Spot"
            android:backgroundTint="#43A047"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>