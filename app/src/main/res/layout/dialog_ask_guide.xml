<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFF8F2">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✨ Ask Namma Guide"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#7E57C2"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etGuideQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ask about local spots, food, or tips..."
        android:padding="14dp"
        android:background="@drawable/edit_text_warm_bg"
        android:textColor="#3E2723"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSendQuestion"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Get Local Tips"
        android:backgroundTint="#7E57C2"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textAllCaps="false"/>

    <ProgressBar
        android:id="@+id/pbGuideLoading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <!-- Scrollable container for AI response -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/tvGuideResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Namma Guide's response will appear here..."
            android:textSize="16sp"
            android:textColor="#3E2723"
            android:lineSpacingExtra="4dp"
            android:background="#F3E5F5"
            android:padding="16dp"
            android:visibility="gone"/>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
