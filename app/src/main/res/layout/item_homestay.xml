<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#D7CCC8"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_toStartOf="@+id/btnEditHomestay">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">
                    <ImageView
                        android:id="@+id/ivHomestayImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_background"
                        android:contentDescription="Homestay Image" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvHomestayName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Homestay Name"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#3E2723" /> <!-- Deep Rich Brown -->

                    <TextView
                        android:id="@+id/tvHomestayLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Location"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#8D6E63"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvHomestayPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0 per night"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnEditHomestay"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#7E57C2"
                android:contentDescription="Edit Homestay" />

        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#F5E6D3"
            android:layout_marginVertical="16dp"/>

        <!-- DESCRIPTION SECTION -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏠 ABOUT THIS HOMESTAY"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:letterSpacing="0.05"/>

        <TextView
            android:id="@+id/tvHomestayDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No description available."
            android:textSize="16sp"
            android:textColor="#212121"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:maxLines="4"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp"/>

        <!-- SPOTS TO VISIT SECTION -->
        <TextView
            android:id="@+id/tvSpotsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 NEARBY SPOTS TO VISIT"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:letterSpacing="0.05"/>

        <TextView
            android:id="@+id/tvHomestaySpots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No spots research yet."
            android:textSize="16sp"
            android:textColor="#1B5E20"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:lineSpacingExtra="2dp"/>

        <Button
            android:id="@+id/btnUpdateMenu"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="View Home Food Menu"
            android:backgroundTint="#FDF2E9"
            android:textColor="#5D4037"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textAllCaps="false"
            app:cornerRadius="12dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>