<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivSpotImage"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:background="#E0E0E0"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Secret Spot Image" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/tvSpotName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spot Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#5D4037" />

            <TextView
                android:id="@+id/tvSpotType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Waterfall"
                android:textSize="14sp"
                android:textColor="#7E57C2"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/tvSpotDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A short mysterious description of the spot..."
                android:textSize="14sp"
                android:textColor="#8D6E63"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>