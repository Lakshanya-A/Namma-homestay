<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍲 Add New Dish"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#4E342E"
            android:layout_marginBottom="18dp"/>

        <!-- DISH NAME -->
        <EditText
            android:id="@+id/dishName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="🍛 Enter Dish Name (e.g. Ragi Roti)"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="12dp"/>

        <!-- IMAGE -->
        <ImageView
            android:id="@+id/dishImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="#E0E0E0"
            android:src="@android:drawable/ic_menu_gallery"
            android:layout_marginBottom="12dp"/>

        <!-- UPLOAD -->
        <Button
            android:id="@+id/uploadDishBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="📸 Select Dish Photo"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF8A65"/>

        <!-- AI -->
        <Button
            android:id="@+id/generateBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="✨ Generate Authentic AI Caption"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7E57C2"
            android:layout_marginTop="10dp"/>

        <!-- DESCRIPTION -->
        <EditText
            android:id="@+id/descriptionText"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="AI will generate a delicious description here..."
            android:gravity="top"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginTop="10dp"/>

        <!-- SAVE -->
        <Button
            android:id="@+id/addDishBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="➕ Add to Menu"
            android:textColor="#FFFFFF"
            android:backgroundTint="#43A047"
            android:layout_marginTop="15dp"/>

    </LinearLayout>

</ScrollView>